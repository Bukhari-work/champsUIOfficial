---
import type { Language } from "@/i18n/ui";
import ThemeToggle from "@/components/site/ThemeToggle.astro";
import LanguageToggle from "@/components/site/LanguageToggle.astro";
import DynamicIcon from "@/components/shared/DynamicIcon";
import Search from "@/components/site/Search.astro";

const { lang = "en" } = Astro.props as { lang?: Language };

const copy =
  lang === "id"
    ? {
        tools: "Buka alat situs",
        title: "Tambahan",
        search: "Cari di situs",
        appearance: "Mode",
        language: "Bahasa",
      }
    : {
        tools: "Open site tools",
        title: "Quick tools",
        search: "Search the site",
        appearance: "Appearance",
        language: "Language",
      };
---

<aside class="fixed right-4 bottom-4 z-50 md:right-8 md:bottom-8">
  <details id="site-tools" class="group">
    <summary
      class="bg-primary text-primary-foreground ring-background hover:bg-primary/90 focus-visible:ring-ring flex h-14 w-14 cursor-pointer list-none items-center justify-center rounded-full shadow-xl ring-4 transition duration-200 hover:-translate-y-0.5 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
      aria-label={copy.tools}
    >
      <DynamicIcon
        icon="LuSlidersHorizontal"
        className="h-5 w-5 transition duration-200 group-open:scale-0 group-open:rotate-90"
        aria-hidden="true"
      />
      <DynamicIcon
        icon="LuX"
        className="absolute h-5 w-5 scale-0 transition duration-200 group-open:scale-100"
        aria-hidden="true"
      />
    </summary>

    <div
      class="border-border bg-popover text-popover-foreground absolute right-0 bottom-[calc(100%+0.75rem)] w-[min(22rem,calc(100vw-2rem))] origin-bottom-right rounded-2xl border p-4 shadow-2xl"
    >
      <div class="mb-4 flex items-center gap-2 px-1">
        <span class="bg-primary/10 text-primary rounded-lg p-2">
          <DynamicIcon
            icon="LuSparkles"
            className="h-4 w-4"
            aria-hidden="true"
          />
        </span>
        <p class="font-semibold">{copy.title}</p>
      </div>

      <button
        type="button"
        data-open-site-search
        aria-haspopup="dialog"
        aria-controls="site-search-dialog"
        class="border-border bg-background text-muted-foreground hover:border-primary/40 hover:text-foreground focus-visible:ring-primary mb-4 flex w-full cursor-pointer items-center gap-3 rounded-xl border px-3 py-3 text-left text-sm transition-colors focus-visible:ring-2 focus-visible:outline-none"
      >
        <DynamicIcon
          icon="LuSearch"
          className="h-4 w-4 shrink-0"
          aria-hidden="true"
        />
        <span class="grow">{copy.search}</span>
        <kbd
          class="border-border rounded border px-1.5 py-0.5 text-xs"
          data-search-shortcut>Ctrl K</kbd
        >
      </button>

      <div class="border-border grid gap-2 border-t pt-4">
        <div
          class="border-border/70 bg-background/60 flex items-center justify-between gap-4 rounded-xl border p-2 pl-3"
        >
          <div class="flex items-center gap-3">
            <span class="bg-primary/10 text-primary rounded-lg p-2">
              <DynamicIcon
                icon="LuPalette"
                className="h-4 w-4"
                aria-hidden="true"
              />
            </span>
            <p class="text-sm font-medium">{copy.appearance}</p>
          </div>
          <ThemeToggle />
        </div>

        <div
          class="border-border/70 bg-background/60 flex items-center justify-between gap-4 rounded-xl border p-2 pl-3"
        >
          <div class="flex items-center gap-3">
            <span class="bg-primary/10 text-primary rounded-lg p-2">
              <DynamicIcon
                icon="LuLanguages"
                className="h-4 w-4"
                aria-hidden="true"
              />
            </span>
            <p class="text-sm font-medium">{copy.language}</p>
          </div>
          <LanguageToggle />
        </div>
      </div>
    </div>
  </details>
</aside>

<Search lang={lang} />

<script is:inline>
  (() => {
    let cleanup;

    const setup = () => {
      const tools = document.getElementById("site-tools");
      if (!(tools instanceof HTMLDetailsElement)) return;

      const onClick = (event) => {
        if (
          tools.open &&
          event.target instanceof Node &&
          !tools.contains(event.target)
        ) {
          tools.open = false;
        }
      };

      const onKeydown = (event) => {
        if (event.key === "Escape" && tools.open) {
          tools.open = false;
          tools.querySelector("summary")?.focus();
        }
      };

      document.addEventListener("click", onClick);
      document.addEventListener("keydown", onKeydown);

      cleanup = () => {
        document.removeEventListener("click", onClick);
        document.removeEventListener("keydown", onKeydown);
      };
    };

    const run = () => {
      cleanup?.();
      setup();
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", run, { once: true });
    } else {
      run();
    }

    document.addEventListener("astro:after-swap", run);
    document.addEventListener("astro:before-swap", () => cleanup?.());
  })();
</script>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
