---
import { getLocalizedPath, useTranslations } from "@/i18n/utils";
import { navigation } from "@/navigation.ts";
import { i18n } from "@/config.ts";
import type { Language } from "@/i18n/ui";

import FullScreenNavigation from "@/components/site/mobile-navigation/FullScreen.astro";
import { Dialog } from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import DynamicIcon from "@/components/shared/DynamicIcon";
import { Image } from "astro:assets";

interface Props {
  lang?: Language;
}

const { lang = i18n.defaultLocale } = Astro.props;
const t = useTranslations(lang);

const nav = navigation[lang];
const homeUrl = nav.header[0]?.href || getLocalizedPath("/", lang);
const island =
  "border-primary/25 bg-background border shadow-md dark:shadow-sm";

const normalize = (path: string) =>
  path === "/" ? "/" : path.replace(/\/+$/, "");

const pathname = normalize(Astro.url.pathname);
const homePathname = normalize(new URL(homeUrl, Astro.url).pathname);

const isActiveHref = (href?: string | URL | null): boolean => {
  if (!href) return false;

  const url = new URL(href, Astro.url);

  // External links should not match the current page.
  if (url.origin !== Astro.url.origin) return false;

  const target = normalize(url.pathname);

  // The homepage only matches its exact path.
  if (target === homePathname) {
    return pathname === target;
  }

  // Other links also match their nested pages.
  return pathname === target || pathname.startsWith(`${target}/`);
};
---

<!-- Full-screen scroll locking stays in Base to avoid the modal's reserved scrollbar gutter. -->
<Dialog id="mobile-navigation" lockScroll={false}>
  <header
    id="site-header"
    transition:name="site-header"
    transition:animate="none"
    class="pointer-events-none fixed inset-x-0 top-3 z-30 w-screen md:top-4"
  >
    <div class="relative mx-3 flex h-full grow md:mx-8 lg:mx-12">
      <nav
        aria-label={t("nav.mainNavigation")}
        class="mx-auto flex h-16 w-full max-w-304 items-center justify-between gap-2"
      >
        <a
          href={homeUrl}
          class:list={[
            island,
            "focus-visible:outline-primary pointer-events-auto flex h-16 shrink-0 items-center rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4",
          ]}
          aria-label={t("nav.homepage")}
        >
          <span class="sr-only">{t("nav.homepage")}</span>

          <!-- Dark mode logo -->
          <Image
            src="/images/Logo-landscape-black.webp"
            alt="Company Logo"
            width={150}
            height={48}
            class="hidden w-28 p-2 transition-transform duration-300 motion-safe:hover:scale-105 motion-reduce:transition-none sm:w-36 dark:block"
            loading="eager"
            decoding="async"
          />

          <!-- Light mode logo -->
          <Image
            src="/images/Logo-landscape-white.webp"
            alt="Company Logo"
            width={150}
            height={48}
            class="block w-28 p-2 transition-transform duration-300 motion-safe:hover:scale-105 motion-reduce:transition-none sm:w-36 dark:hidden"
            loading="eager"
            decoding="async"
          />
        </a>

        <div
          id="desktop-menu"
          class:list={[
            island,
            "pointer-events-auto hidden h-16 items-center rounded-xl px-3 lg:flex",
          ]}
        >
          <ul
            id="navigation"
            class="inline-flex w-auto justify-center space-x-1 self-center px-2 text-center text-sm"
          >
            {
              nav.header.map((menu) => {
                const isActive = isActiveHref(menu.href);

                return (
                  <li>
                    <a
                      href={menu.href}
                      class:list={[
                        "text-foreground/80 hover:bg-primary/12 focus-visible:outline-primary block rounded-xl px-3 py-3 whitespace-nowrap focus-visible:outline-2 focus-visible:outline-offset-2",
                        {
                          "text-primary/80": isActive,
                          "bg-primary/12": isActive,
                        },
                      ]}
                      aria-current={isActive ? "page" : undefined}
                    >
                      {t(menu.textKey)}
                    </a>
                  </li>
                );
              })
            }
          </ul>

          {
            nav.callToAction && (
              <Button
                size="lg"
                class="my-auto h-11 transition-[translate,box-shadow,background-color] duration-200 hover:shadow-md motion-safe:hover:-translate-y-1 motion-reduce:transition-none"
                href={nav.callToAction.href}
              >
                {t(nav.callToAction.textKey)}
              </Button>
            )
          }
        </div>

        <div
          id="mobile-menu"
          class:list={[
            island,
            "pointer-events-auto flex h-16 items-center gap-1 rounded-xl p-2 lg:hidden",
          ]}
        >
          {
            nav.callToAction && (
              <Button
                size="sm"
                class="bg-primary h-11 rounded-lg px-3 align-middle text-xs transition-colors duration-200 motion-reduce:transition-none"
                href={nav.callToAction.href}
              >
                {t(nav.callToAction.textKey)}
              </Button>
            )
          }
          <Button
            variant="outline"
            size="sm"
            data-slot="dialog-trigger"
            aria-controls="mobile-navigation-content"
            class="bg-background border-primary/25 text-primary hover:bg-primary-soft hover:text-primary size-11 rounded-lg px-0 align-middle"
            aria-label={t("nav.openMenu")}
          >
            <DynamicIcon icon="LuMenu" aria-hidden="true" />
          </Button>
        </div>
      </nav>
    </div>
  </header>

  <FullScreenNavigation {lang} />
</Dialog>
