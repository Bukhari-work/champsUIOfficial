---
import { Image } from "astro:assets";
import type { Language } from "@/i18n/ui";
import { useTranslations, getLocalizedPath } from "@/i18n/utils";
import Button from "@/components/ui-astro/Button.astro";
import DynamicIcon from "@/components/shared/DynamicIcon";
import { heroPhoto, teamPortraits } from "@/assets/home";
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  class="bg-background relative isolate grid min-h-svh w-full items-end overflow-hidden px-5 pt-40 pb-10 md:px-8 lg:items-center lg:px-12 lg:py-20"
  data-home-section="hero"
  aria-labelledby="home-title"
>
  <div class="relative z-1 mx-auto grid w-full max-w-304 gap-5 md:gap-6">
    <div class="max-w-xl">
      <p
        class="flex items-center gap-3 text-xs leading-relaxed font-medium text-white/90"
      >
        <span class="bg-kuning h-1 w-8 shrink-0 rounded-full" aria-hidden="true"
        ></span>
        <span>
          {t("hero.tagline")}<span aria-hidden="true"> · </span>Universitas
          Indonesia
        </span>
      </p>
      <p
        class="mt-2 max-w-xl text-xs leading-relaxed font-medium tracking-wide text-white/80 md:text-sm"
      >
        {t("hero.title")}
      </p>
    </div>
    <h1
      id="home-title"
      class="wrap-break-words max-w-3xl min-w-0 text-3xl leading-tight font-extrabold tracking-normal text-balance text-white text-shadow-black/60 text-shadow-md sm:text-4xl lg:text-5xl"
    >
      <span class="sm:block">
        {t("home.hero.title1")}
      </span>{" "}
      <span class="sm:block">
        {t("home.hero.title2")}
      </span>{" "}
      <span class="text-kuning mt-3 block text-2xl sm:text-3xl lg:text-4xl"
        >{t("home.hero.title3")}</span
      >
    </h1>
    <div
      class="bg-primary-soft border-primary/25 border-t-primary grid min-w-0 gap-4 rounded-xl border border-t-3 p-5 shadow-md md:grid-cols-12 md:items-center md:gap-x-8 md:p-6 lg:p-7 dark:shadow-sm"
    >
      <p class="text-foreground max-w-md text-sm leading-relaxed md:col-span-5">
        {t("hero.subtitle")}
      </p>
      <div
        class="flex flex-wrap gap-3 md:col-span-7 md:col-start-6 md:row-span-2 md:row-start-1 md:justify-end md:self-center"
      >
        <Button
          text={t("hero.action.contact")}
          href="https://wa.me/6281324096624"
          target="_blank"
          rel="noopener noreferrer"
          icon="FaWhatsapp"
          size="lg"
          class="h-12 rounded-xl px-4 text-sm sm:px-5"
        />
        <Button
          text={t("hero.action.expertise")}
          href={getLocalizedPath("/what-we-do", lang)}
          icon="FaArrowRightLong"
          variant="outline"
          size="lg"
          class="border-primary/25 bg-background text-primary hover:bg-primary-soft hover:text-primary h-12 rounded-xl px-4 text-sm sm:px-5"
        />
      </div>
      <a
        href={getLocalizedPath("/about/people", lang)}
        class="text-foreground/75 hover:text-primary focus-visible:outline-primary border-primary/20 dark:text-muted-foreground flex w-full items-center gap-3 border-t pt-4 text-xs leading-relaxed underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 md:col-span-5 md:col-start-1 md:row-start-2"
      >
        <span class="flex shrink-0 pl-2" aria-hidden="true">
          {
            teamPortraits.map((src) => (
              <Image
                src={src}
                alt=""
                width={32}
                height={32}
                densities={[1, 2]}
                format="webp"
                quality={80}
                loading="lazy"
                class="border-background -ml-2 size-8 rounded-full border-2 object-cover object-[center_25%]"
              />
            ))
          }
        </span>
        <span>{t("home.hero.people")}</span>
        <DynamicIcon
          icon="FaArrowRightLong"
          className="size-3 shrink-0"
          aria-hidden="true"
        />
      </a>
    </div>
  </div>
  <figure class="bg-background absolute inset-0 min-w-0 overflow-hidden">
    <Image
      src={heroPhoto}
      width={1200}
      height={800}
      widths={[480, 768, 1200, 1620]}
      sizes="max(100vw, 150svh)"
      format="webp"
      quality={80}
      alt={t("home.hero.photoAlt")}
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover object-[center_70%]"
    />
    <div
      class="absolute inset-0 bg-linear-to-r from-black/65 via-black/35 to-black/5 dark:from-black/85 dark:via-black/50 dark:to-black/10"
      aria-hidden="true"
    >
    </div>
    <div
      class="from-background pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-linear-to-t to-transparent md:h-40"
      data-hero-transition
      aria-hidden="true"
    >
    </div>
  </figure>
</section>
