---
import { Image } from "astro:assets";
import type { Language } from "@/i18n/ui";
import { useTranslations, getLocalizedPath } from "@/i18n/utils";
import Button from "@/components/ui-astro/Button.astro";
import DynamicIcon from "@/components/shared/DynamicIcon";
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  class="bg-background relative isolate mx-auto flex max-w-304 flex-col pt-4 pb-8 md:pb-14"
  data-home-section="hero"
  aria-labelledby="home-title"
>
  <div
    class="bg-background border-t-primary relative z-1 mx-5 -mt-6 min-w-0 rounded-xl border border-t-3 px-5 py-6 shadow-sm shadow-black/5 md:mx-6 md:-mt-32 md:grid md:grid-cols-2 md:gap-x-7 md:gap-y-4 md:p-7 md:[grid-template-areas:'institution_name'_'title_description'_'title_actions'_'title_team'] lg:mx-10 lg:gap-x-12 lg:p-10"
  >
    <p
      class="text-primary m-0 text-xs leading-relaxed font-medium [grid-area:institution]"
    >
      {t("hero.tagline")}<span aria-hidden="true"> · </span>Universitas
      Indonesia
    </p>
    <h1
      id="home-title"
      class="mt-5 self-center text-3xl leading-tight font-semibold tracking-tight [grid-area:title] sm:text-4xl md:mt-0 xl:text-5xl [&>span]:block"
    >
      <span>{t("home.hero.title1")}</span>
      <span>{t("home.hero.title2")}</span>
      <span class="text-primary">{t("home.hero.title3")}</span>
    </h1>
    <p
      class="text-foreground/80 mt-5 max-w-116 text-xs leading-relaxed font-medium tracking-wide [grid-area:name] md:mt-0"
    >
      {t("hero.title")}
    </p>
    <p
      class="text-muted-foreground mt-3 max-w-md text-sm leading-relaxed [grid-area:description] md:mt-0"
    >
      {t("hero.subtitle")}
    </p>
    <div
      class="mt-5 flex flex-wrap gap-3 [grid-area:actions] md:mt-1 [&_a]:px-4 [&_a]:text-xs lg:[&_a]:px-5 lg:[&_a]:text-sm"
    >
      <Button
        text={t("hero.action.contact")}
        href="https://wa.me/6281324096624"
        target="_blank"
        rel="noopener noreferrer"
        icon="FaWhatsapp"
        size="lg"
        class="h-12 rounded-xl px-5"
      />
      <Button
        text={t("hero.action.expertise")}
        href={getLocalizedPath("/what-we-do", lang)}
        icon="FaArrowRightLong"
        variant="outline"
        size="lg"
        class="border-primary/20 text-primary hover:bg-primary/10 hover:text-primary h-12 rounded-xl px-5"
      />
    </div>
    <a
      class="text-muted-foreground hover:text-primary mt-5 flex w-fit items-center gap-3 text-xs leading-relaxed [grid-area:team] md:mt-1"
      href={getLocalizedPath("/about/people", lang)}
    >
      <span
        class="[&_img]:border-background flex shrink-0 pl-2 [&_img]:-ml-2 [&_img]:size-8 [&_img]:rounded-[50%] [&_img]:border-2 [&_img]:object-cover [&_img]:object-[center_25%]"
        aria-hidden="true"
      >
        <Image
          src="/images/people/ede-surya-darmawan.webp"
          alt=""
          width={40}
          height={40}
        />
        <Image
          src="/images/people/putu-mas-dewi-pratiwi.webp"
          alt=""
          width={40}
          height={40}
        />
        <Image
          src="/images/people/sheila-rizkia-anjari.webp"
          alt=""
          width={40}
          height={40}
        />
      </span>
      <span>{t("home.hero.people")}</span>
      <DynamicIcon
        icon="FaArrowRightLong"
        className="size-3 shrink-0"
        aria-hidden="true"
      />
    </a>
  </div>
  <div class="relative -order-1 mb-0 min-w-0">
    <figure
      class="bg-background border-primary/20 overflow-hidden rounded-xl border"
    >
      <Image
        src="/images/marquee/Home - Foto Berjalan 2.webp"
        width={1200}
        height={800}
        alt={t("home.hero.photoAlt")}
        loading="eager"
        fetchpriority="high"
        class="h-[clamp(14rem,65vw,23rem)] w-full object-cover object-[center_60%] md:h-[clamp(20rem,34vw,29rem)]"
      />
      <figcaption
        class="text-primary bg-background absolute top-3 right-3 flex items-center gap-3 rounded-md px-4 py-3 text-xs font-medium shadow-sm md:top-5 md:right-5 md:px-5 md:py-4"
      >
        <DynamicIcon
          icon="FaUsers"
          className="size-4 shrink-0"
          aria-hidden="true"
        />
        <span>{t("home.hero.photoCaption")}</span>
        <span class="bg-kuning ml-3 size-2 rounded-[50%]" aria-hidden="true"
        ></span>
      </figcaption>
    </figure>
  </div>
</section>
