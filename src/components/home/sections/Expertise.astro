---
import type { Language } from "@/i18n/ui";
import { useTranslations, getLocalizedPath } from "@/i18n/utils";
import Card from "@/components/blocks/Card.astro";
import { slugify } from "@/lib/utils/textConverter";
import SectionHeading from "../shared/SectionHeading.astro";
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const expertise = [
  {
    title: t("whatWeDo.research.title"),
    description: t("home.expertise.research"),
    image: "/images/what-we-do/research.webp",
  },
  {
    title: t("whatWeDo.consultation.title"),
    description: t("home.expertise.consultation"),
    image: "/images/what-we-do/consultation.webp",
  },
  {
    title: t("whatWeDo.capacity.title"),
    description: t("home.expertise.capacity"),
    image: "/images/what-we-do/capacity-building.webp",
  },
  {
    title: t("whatWeDo.csr.title"),
    description: t("home.expertise.csr"),
    image: "/images/what-we-do/corporate.webp",
  },
];
---

<section
  id="home-expertise"
  class="mx-auto max-w-6xl scroll-mt-24 px-5 py-14 sm:px-6 sm:py-20"
  aria-labelledby="expertise-title"
>
  <SectionHeading
    number="01"
    label={t("hero.action.expertise")}
    title={t("home.story.expertiseTitle")}
    description={t("home.expertise.subtitle")}
    id="expertise-title"
    href={getLocalizedPath("/what-we-do", lang)}
    linkText={t("home.story.services")}
  />
  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {
      expertise.map((area, index) => (
        <Card
          title={area.title}
          href={`${getLocalizedPath("/what-we-do", lang)}#${slugify(area.title)}`}
          imageMeta={{ src: area.image, alt: area.title }}
          headingLevel="h3"
          size="small"
          class="h-full rounded-xl"
        >
          <div
            slot="eyebrow"
            class="text-primary/70 mb-3 flex items-center justify-between text-xs font-medium"
            data-service-number
          >
            <span>{String(index + 1).padStart(2, "0")}</span>
            <span aria-hidden="true">↗</span>
          </div>
          <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
            {area.description}
          </p>
        </Card>
      ))
    }
  </div>
</section>
