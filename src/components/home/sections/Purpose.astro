---
import type { Language } from "@/i18n/ui";
import { useTranslations, getLocalizedPath } from "@/i18n/utils";
import { Image } from "astro:assets";
import { purposePhoto } from "@/assets/home";
import Quote from "@/components/ui/Quote.astro";
import SectionHeading from "../components/SectionHeading.astro";
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="home-gallery"
  class="py-14 sm:py-20"
  aria-labelledby="purpose-title"
  data-home-section="people"
>
  <div class="mx-auto max-w-6xl px-5 sm:px-6">
    <div class="grid grid-cols-1 items-center gap-8 md:grid-cols-2 lg:gap-14">
      <figure class="bg-background overflow-hidden rounded-xl border">
        <Image
          src={purposePhoto}
          alt={t("home.story.photoAlt")}
          width={960}
          height={640}
          widths={[480, 768, 960, 1440]}
          sizes="(min-width: 1280px) 544px, (min-width: 768px) 50vw, 100vw"
          format="webp"
          quality={80}
          loading="lazy"
          class="h-[clamp(14rem,65vw,23rem)] w-full object-cover md:h-[clamp(18rem,30vw,25rem)]"
        />
        <figcaption class="text-primary bg-primary-soft px-5 py-4 text-xs">
          {t("home.gallery.subtitle")}
        </figcaption>
      </figure>
      <div class="max-w-none md:max-w-120">
        <SectionHeading
          number="03"
          label={t("home.story.purpose")}
          title={t("home.story.purposeTitle")}
          id="purpose-title"
        />
        <p class="text-muted-foreground text-sm leading-loose">
          {t("home.story.purposeBody")}
        </p>
        <a
          class="link text-primary focus-visible:outline-primary mt-6 inline-flex min-h-11 items-center gap-3 rounded text-sm focus-visible:outline-2 focus-visible:outline-offset-4"
          href={getLocalizedPath("/about", lang)}
          >{t("home.story.about")} <span aria-hidden="true">→</span></a
        >
      </div>
    </div>
    <Quote
      class="text-primary mx-auto my-6 max-w-4xl px-2 text-center text-sm leading-loose sm:my-4 sm:px-6 md:text-lg"
      quote={t("quote.champs")}
    />
  </div>
</section>
