---
import type { Language } from "@/i18n/ui";
import { useTranslations, getLocalizedPath } from "@/i18n/utils";
import CallToAction from "@/components/shared/CallToAction.astro";
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="mx-auto mb-16 max-w-6xl px-5 sm:px-6">
  <CallToAction
    headingId="collaboration-title"
    number="05"
    eyebrow={t("home.story.next")}
    title={t("home.collaboration.title")}
    description={t("home.collaboration.description")}
    action={{
      href: getLocalizedPath("/contact", lang),
      label: t("hero.action.contact"),
    }}
    data-home-section="collaboration"
  />
</div>
