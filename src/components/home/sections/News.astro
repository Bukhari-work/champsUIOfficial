---
import type { Language } from "@/i18n/ui";
import { useTranslations, getLocalizedPath } from "@/i18n/utils";
import CardNewsSm from "@/components/CardNewsSm.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import SectionHeading from "../shared/SectionHeading.astro";
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const currentPosts = sortByDate(await getSinglePage("news"))
  .filter((post) => post.id && post.id.startsWith(`${lang}/`))
  .slice(0, 3);
---

<section
  class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-20"
  aria-labelledby="news-title"
  data-home-section="news"
>
  <SectionHeading
    number="04"
    label={t("home.story.news")}
    title={t("home.story.newsTitle")}
    description={t("home.story.newsBody")}
    id="news-title"
    href={getLocalizedPath("/news", lang)}
    linkText={t("news.all")}
  />
  <div class="grid gap-4 lg:grid-cols-3">
    {currentPosts.map((post) => <CardNewsSm data={post} />)}
  </div>
</section>
