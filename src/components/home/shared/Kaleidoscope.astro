---
import { Image } from "astro:assets";
import type { Language } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import DynamicIcon from "@/components/shared/DynamicIcon";
import { buttonVariants } from "@/components/ui/button-variants";
import { cn } from "@/lib/utils";
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const patternId = `kaleidoscope-pattern-${crypto.randomUUID().slice(0, 8)}`;
const actionClass = cn(
  buttonVariants({ variant: "default", size: "lg" }),
  "col-start-1 h-12 self-start justify-self-start rounded-xl md:col-start-2 md:self-center lg:col-auto lg:justify-self-auto",
);
---

<section class="m-0 max-w-none p-0" aria-labelledby="kaleidoscope-title">
  <details
    class="group/kaleidoscope bg-background hover:border-primary overflow-hidden rounded-xl border-2 transition duration-150 ease-in-out hover:shadow-md motion-reduce:transition-none motion-reduce:duration-0"
    data-kaleidoscope
  >
    <summary
      class="focus-visible:outline-primary relative isolate grid cursor-pointer list-none grid-cols-1 items-start gap-5 p-5 focus-visible:outline-2 focus-visible:outline-offset-[-5px] md:grid-cols-[auto_minmax(0,1fr)] md:items-center md:gap-x-5 md:gap-y-4 lg:flex lg:gap-7 [&::-webkit-details-marker]:hidden"
      aria-controls="kaleidoscope-player"
    >
      <svg
        class="text-primary pointer-events-none absolute inset-0 -z-1 size-full opacity-0 group-hover/kaleidoscope:opacity-10"
        aria-hidden="true"
        ><defs
          ><pattern
            id={patternId}
            width="4"
            height="4"
            patternUnits="userSpaceOnUse"
            patternTransform="rotate(45)"
            ><line
              x1="0"
              y1="0"
              x2="0"
              y2="4"
              stroke="currentColor"
              stroke-width="2"></line></pattern
          ></defs
        ><rect width="100%" height="100%" fill={`url(#${patternId})`}
        ></rect></svg
      >
      <span
        class="bg-muted relative h-[clamp(10rem,45vw,16rem)] w-full shrink-0 overflow-hidden rounded-md md:row-span-2 md:h-32 md:w-44 lg:row-auto lg:h-40 lg:w-60"
        aria-hidden="true"
      >
        <Image
          src="/images/marquee/Home - Foto Berjalan 3.webp"
          alt=""
          width={600}
          height={400}
          loading="lazy"
          class="block size-full object-cover object-[center_65%]"
        />
        <span
          class="bg-primary text-primary-foreground absolute top-1/2 left-1/2 grid size-12 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-xl pl-1 shadow-md"
          ><DynamicIcon icon="FaPlay" className="size-4" /></span
        >
      </span>
      <span
        class="col-start-1 m-0 flex min-w-0 flex-col gap-3 md:col-start-2 md:mr-auto lg:col-auto"
      >
        <span
          class="text-lg leading-normal font-semibold tracking-tight"
          id="kaleidoscope-title"
          role="heading"
          aria-level="3"
        >
          {t("home.video.recapTitle")}
        </span>
        <span class="text-muted-foreground max-w-md text-sm leading-relaxed">
          {t("home.video.recapDescription")}
        </span>
      </span>
      <span class={cn(actionClass, "group-open/kaleidoscope:hidden")}>
        {t("home.video.expand")}<DynamicIcon
          icon="FaChevronDown"
          className="size-3"
          aria-hidden="true"
        />
      </span>
      <span
        class={cn(actionClass, "hidden group-open/kaleidoscope:inline-flex")}
      >
        {t("home.video.collapse")}<DynamicIcon
          icon="FaChevronUp"
          className="size-3"
          aria-hidden="true"
        />
      </span>
    </summary>
    <div id="kaleidoscope-player" class="bg-primary/3 border-t p-4 md:p-5">
      <div class="bg-muted aspect-video overflow-hidden rounded-md border">
        <iframe
          class="block size-full [border:0]"
          data-video-src="https://www.youtube-nocookie.com/embed/byjpp35gmXw"
          title={t("video.title")}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen></iframe>
      </div>
    </div>
  </details>
  <noscript
    ><p class="text-primary mt-4 text-sm">
      <a
        href="https://www.youtube.com/watch?v=byjpp35gmXw"
        target="_blank"
        rel="noopener noreferrer">{t("home.story.watch")} ↗</a
      >
    </p></noscript
  >
</section>
<script>
  function setupKaleidoscopes() {
    document
      .querySelectorAll<HTMLDetailsElement>("[data-kaleidoscope]")
      .forEach((details) => {
        if (details.dataset.ready) return;
        details.dataset.ready = "true";
        const frame = details.querySelector<HTMLIFrameElement>("iframe");
        details.addEventListener("toggle", () => {
          if (!frame) return;
          if (details.open) frame.src = frame.dataset.videoSrc || "";
          else frame.removeAttribute("src");
        });
      });
  }
  setupKaleidoscopes();
  document.addEventListener("astro:page-load", setupKaleidoscopes);
</script>
