---
import { Marquee } from "@/components/ui/marquee/index";
import { Image } from "astro:assets";
import { communityPhotos } from "@/assets/home";
---

<div
  class="bg-background relative flex h-full w-full flex-col items-center justify-center overflow-hidden"
>
  <Marquee
    time={60}
    variant="solid"
    class="[&:hover_.marquee-content]:paused p-2 px-4 [&_.marquee-content]:gap-2 [&_.marquee-content]:pr-2"
  >
    {
      communityPhotos.map((src) => (
        <figure class="relative flex h-full shrink-0 justify-center rounded-2xl border-2 border-transparent p-1">
          <Image
            class="h-36 w-56 rounded-xl border object-cover sm:h-44 sm:w-72"
            alt=""
            src={src}
            loading="lazy"
            width={288}
            widths={[224, 288, 448, 576]}
            sizes="(min-width: 640px) 288px, 224px"
            format="webp"
            quality={80}
          />
        </figure>
      ))
    }
  </Marquee>
  <div
    class="from-background pointer-events-none absolute inset-y-0 left-0 w-1/12 bg-linear-to-r"
    aria-hidden="true"
  >
  </div>
  <div
    class="from-background pointer-events-none absolute inset-y-0 right-0 w-1/12 bg-linear-to-l"
    aria-hidden="true"
  >
  </div>
</div>
