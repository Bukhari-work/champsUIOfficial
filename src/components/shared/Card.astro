---
import { Image } from "astro:assets";
import { cn } from "@/lib/utils";
import { getImageAsset } from "@/lib/imageAssets";
import type { ImageMetadata } from "astro";

export interface Props {
  href?: string;
  title: string;
  imageMeta?: ImageMetadata | { alt: string; src: string | ImageMetadata };
  imageAlt?: string;
  imageAspect?: "video" | "portrait" | "landscape" | "square";
  imageWidths?: number[];
  imageSizes?: string;
  headingLevel?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  size?: "default" | "small";
  class?: string;
}

const {
  href,
  title,
  imageMeta,
  imageAlt,
  imageAspect = "video",
  imageWidths,
  imageSizes,
  headingLevel: Heading = "h2",
  size = "default",
  class: className,
} = Astro.props;

const isSmall = size === "small";
const imageSrc = imageMeta
  ? "width" in imageMeta
    ? imageMeta
    : imageWidths
      ? await getImageAsset(imageMeta.src)
      : imageMeta.src
  : undefined;
const imageProps = !imageSrc
  ? undefined
  : typeof imageSrc === "string"
    ? { src: imageSrc, width: isSmall ? 320 : 445, height: isSmall ? 180 : 230 }
    : { src: imageSrc, width: isSmall ? 320 : 445 };
const patternId = `pattern-${crypto.randomUUID().slice(0, 8)}`;

// One native primary link covers the card. Secondary controls belong above it
// in a relative z-10 container (for example, a person's email links).
const Title = href ? "a" : "span";
---

<article
  class={cn(
    "group bg-background relative isolate flex flex-col overflow-hidden",
    href &&
      "hover:border-primary focus-within:border-primary focus-within:ring-primary focus-within:ring-2 motion-safe:transition-transform motion-safe:duration-150 motion-safe:hover:-translate-y-1",
    isSmall ? "gap-3 rounded-lg border p-4" : "gap-6 rounded-xl border-2 p-6",
    className,
  )}
>
  {/* SVG background pattern */}
  <svg
    class:list={[
      "text-primary pointer-events-none invisible absolute inset-0 -z-1 size-full opacity-15 select-none",
      href &&
        "group-focus-within:visible group-focus-within:opacity-25 group-hover:visible group-hover:opacity-25",
    ]}
    aria-hidden="true"
  >
    <defs>
      <pattern
        id={patternId}
        width="4"
        height="4"
        patternUnits="userSpaceOnUse"
        patternTransform="rotate(45)"
      >
        <line
          x1="0"
          y1="0"
          x2="0"
          y2="4"
          stroke="currentColor"
          stroke-width="1.5"></line>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#${patternId})`}></rect>
  </svg>

  {
    Astro.slots.has("media") ? (
      <slot name="media" />
    ) : (
      imageProps && (
        <div
          class={cn(
            "relative overflow-hidden",
            imageAspect === "square"
              ? "aspect-square"
              : imageAspect === "portrait"
                ? "aspect-[5/6]"
                : imageAspect === "landscape"
                  ? "aspect-[4/3]"
                  : "aspect-video",
            isSmall ? "rounded-md" : "rounded-lg",
          )}
        >
          <Image
            class="h-full w-full object-cover"
            {...imageProps}
            alt={imageAlt || title}
            widths={imageWidths}
            sizes={imageSizes}
            format="webp"
            quality={80}
          />
        </div>
      )
    )
  }

  {/* Content Column */}
  <div class="flex flex-1 flex-col justify-between">
    <section>
      <header>
        <slot name="eyebrow" />
        <Heading
          class={cn(
            "font-bold",
            href && "group-hover:text-primary group-focus-within:text-primary",
            isSmall ? "text-base font-semibold" : "text-xl",
            href && "line-clamp-2",
          )}
        >
          <Title
            href={href}
            class:list={[
              href &&
                "after:absolute after:inset-0 after:cursor-pointer focus-visible:underline focus-visible:underline-offset-4 focus-visible:outline-none",
            ]}
            data-card-link={href ? "" : undefined}>{title}</Title
          >
        </Heading>
      </header>

      <slot />
    </section>

    <div class="mt-auto pt-2">
      <slot name="footer" />
    </div>
  </div>
</article>
