---
import type { DirectoryItem } from "@/lib/contentCatalog";
import type { Language } from "@/i18n/ui";
import { contentCopy } from "@/i18n/content";
import Card from "@/components/shared/Card.astro";
import { buttonVariants } from "@/components/ui/button";
interface Props {
  item: DirectoryItem;
  lang: Language;
  size?: "default" | "small";
  imageSizes?: string;
  headingLevel?: "h3" | "h4" | "h5";
}
const {
  item,
  lang,
  size = "default",
  imageSizes = "(min-width: 1280px) 490px, (min-width: 768px) 40vw, 90vw",
  headingLevel = "h3",
} = Astro.props;
const copy = contentCopy[lang];
const isSmall = size === "small";
---

<Card
  {size}
  href={item.href}
  title={item.title}
  {headingLevel}
  imageMeta={item.image}
  imageAlt={item.image?.alt}
  imageWidths={[320, 640, 960]}
  {imageSizes}
>
  <p slot="eyebrow" class="text-primary mb-2 font-mono text-xs">
    {item.category} · {item.date}
  </p>
  {
    isSmall ? (
      <p class="mt-2 line-clamp-2 text-sm">{item.description}</p>
    ) : (
      <div class="mt-2 border-t pt-2 sm:pl-6">
        <p class="mt-2 mb-2 line-clamp-3">{item.description}</p>
      </div>
    )
  }
  {item.note && <p class="text-muted-foreground mt-3 text-xs">{item.note}</p>}
  {
    item.href && (
      <span
        slot="footer"
        aria-hidden="true"
        class={buttonVariants({
          className: isSmall
            ? "h-auto min-h-11 max-w-full px-3 py-1 text-xs whitespace-normal"
            : "h-auto min-h-11 max-w-full whitespace-normal",
        })}
      >
        {item.action ?? copy.readStory}
      </span>
    )
  }
</Card>
