---
import type { DirectoryItem } from "@/lib/contentCatalog";
import type { Language } from "@/i18n/ui";
import { contentCopy } from "@/i18n/content";
import Card from "@/components/shared/Card.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
interface Props {
  item: DirectoryItem;
  lang: Language;
  size?: "default" | "small";
  imageSizes?: string;
  headingLevel?: "h3" | "h4" | "h5";
}
const {
  item,
  lang,
  size = "default",
  imageSizes = "(min-width: 1280px) 490px, (min-width: 768px) 40vw, 90vw",
  headingLevel = "h3",
} = Astro.props;
const copy = contentCopy[lang];
const isSmall = size === "small";
---

<Card
  {size}
  href={item.href}
  title={item.title}
  {headingLevel}
  imageMeta={item.image}
  imageAlt={item.image?.alt}
  imageWidths={[320, 480, 640, 960]}
  {imageSizes}
  class={cn(
    "content-card @container/content h-full min-w-0 [&>div:has(>img)]:shrink-0 [&_header>:is(h3,h4,h5)]:font-semibold [&_header>:is(h3,h4,h5)]:leading-snug [&_header>:is(h3,h4,h5)]:wrap-anywhere",
    isSmall
      ? "p-3 sm:p-4 [&_header>:is(h3,h4,h5)]:text-[clamp(1rem,5cqi,1.125rem)]"
      : "gap-[clamp(1rem,1.5vw,1.5rem)] p-[clamp(1rem,2vw,1.5rem)] [&_header>:is(h3,h4,h5)]:text-[clamp(1.125rem,4.5cqi,1.375rem)]",
  )}
>
  <p
    slot="eyebrow"
    class="text-primary mb-2 font-mono text-[clamp(0.6875rem,3.3cqi,0.75rem)] leading-relaxed wrap-anywhere"
  >
    {item.category} · {item.date}
  </p>
  {
    item.description &&
      (isSmall ? (
        <p class="text-muted-foreground mt-2 line-clamp-2 text-[clamp(0.8125rem,4cqi,0.875rem)] leading-relaxed wrap-anywhere">
          {item.description}
        </p>
      ) : (
        <div class="mt-2 border-t pt-2 sm:pl-6">
          <p class="text-muted-foreground mt-2 mb-2 line-clamp-3 text-[clamp(0.875rem,3.8cqi,1rem)] leading-relaxed wrap-anywhere">
            {item.description}
          </p>
        </div>
      ))
  }
  {item.note && <p class="text-muted-foreground mt-3 text-xs">{item.note}</p>}
  {
    item.href && (
      <span
        slot="footer"
        aria-hidden="true"
        class={buttonVariants({
          className: isSmall
            ? "h-auto min-h-11 max-w-full px-3 py-1 text-[clamp(0.75rem,3.5cqi,0.875rem)] whitespace-normal"
            : "h-auto min-h-11 max-w-full text-[clamp(0.8125rem,3.5cqi,0.875rem)] whitespace-normal",
        })}
      >
        {item.action ?? copy.readStory}
      </span>
    )
  }
</Card>
