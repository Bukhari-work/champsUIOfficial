---
import DynamicIcon from "@/components/shared/DynamicIcon.tsx";
import { cn } from "@/lib/utils";
import type { SocialLink } from "@/types.ts";

interface Props {
  socialLinks?: SocialLink[];
  class?: string;
  linkClass?: string;
}

const { class: className, socialLinks = [], linkClass } = Astro.props;
---

{
  socialLinks?.length ? (
    <ul class={cn("mb-4 -ml-2 flex md:mb-0", className)}>
      {socialLinks.map(({ ariaLabel, href, icon, platform, text }) => (
        <li>
          <a
            class={cn(
              "hover:bg-primary/20 dark:hover:bg-primary/12 inline-flex items-center rounded-lg p-2 text-sm",
              linkClass,
            )}
            aria-label={ariaLabel}
            href={href}
          >
            {icon && <DynamicIcon icon={icon} className="h-5 w-5 mx-1" />}
            <Fragment set:html={text} />
          </a>
        </li>
      ))}
    </ul>
  ) : (
    ""
  )
}
