---
import DynamicIcon from "@/components/shared/DynamicIcon.tsx";
import { cn } from "@/lib/utils";
import type { SocialLink } from "@/types.ts";

interface Props {
  socialLinks?: SocialLink[];
  class?: string;
  linkClass?: string;
}

const { class: className, socialLinks = [], linkClass } = Astro.props;
---

{
  socialLinks?.length ? (
    <ul class={cn("mb-4 -ml-2 flex flex-wrap md:mb-0", className)}>
      {socialLinks.map(({ ariaLabel, href, icon, text }) => (
        <li class="max-w-full min-w-0">
          <a
            class={cn(
              "hover:bg-primary/20 dark:hover:bg-primary/12 focus-visible:outline-primary inline-flex min-h-11 max-w-full items-center rounded-lg p-2 text-sm wrap-anywhere focus-visible:outline-2 focus-visible:outline-offset-2",
              linkClass,
            )}
            aria-label={ariaLabel}
            href={href}
          >
            {icon && (
              <DynamicIcon
                icon={icon}
                className="mx-1 size-5 shrink-0"
                aria-hidden="true"
              />
            )}
            <Fragment set:html={text} />
          </a>
        </li>
      ))}
    </ul>
  ) : (
    ""
  )
}
