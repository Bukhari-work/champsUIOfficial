---
import type { Language } from "@/i18n/ui";
import { getLangFromUrl } from "@/i18n/utils";
import DynamicIcon from "@/components/shared/DynamicIcon";

export interface Props {
  images?: { src: string; alt: string }[];
  lang?: Language;
}
const { images = [], lang = getLangFromUrl(Astro.url) } = Astro.props;
const photos = images
  .filter((image) => image.src.trim())
  .map((image) => ({
    ...image,
    // Some content paths contain duplicate slashes; preserve remote URLs.
    src:
      image.src.startsWith("/") && !image.src.startsWith("//")
        ? image.src.replace(/\/{2,}/g, "/")
        : image.src,
  }));
const copy =
  lang === "id"
    ? {
        gallery: "Galeri foto",
        previous: "Foto sebelumnya",
        next: "Foto berikutnya",
        count: "Foto {current} dari {total}",
        slide: "Foto {{index}} dari {{slidesLength}}",
        carousel: "Karusel",
        photo: "Foto",
      }
    : {
        gallery: "Photo gallery",
        previous: "Previous photo",
        next: "Next photo",
        count: "Photo {current} of {total}",
        slide: "Photo {{index}} of {{slidesLength}}",
        carousel: "Carousel",
        photo: "Photo",
      };
const buttonClass =
  "bg-primary/10 text-primary hover:bg-primary/20 focus-visible:outline-primary inline-flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-default disabled:opacity-40";
---

{
  photos.length > 0 && (
    <gallery-deck
      class="not-prose my-6 block w-full max-w-full min-w-0 **:[[hidden]]:hidden!"
      data-copy={JSON.stringify(copy)}
      data-language={lang}
      role="region"
      aria-label={copy.gallery}
    >
      <div class="relative">
        <div
          class="article-image-slider swiper focus-visible:outline-primary w-full min-w-0 overflow-hidden rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 [&:not(.swiper-initialized)]:snap-x [&:not(.swiper-initialized)]:snap-mandatory [&:not(.swiper-initialized)]:overflow-x-auto"
          data-gallery-slider
          tabindex={photos.length > 1 ? "0" : undefined}
          aria-label={copy.gallery}
        >
          <div class="swiper-wrapper items-center">
            {photos.map((photo, index) => (
              <div
                class:list={[
                  "swiper-slide pointer-events-auto! shrink-0 snap-center",
                  photos.length > 1 ? "w-full! md:w-4/5!" : "w-full!",
                ]}
              >
                <div class="bg-muted/30 relative aspect-16/10 max-h-128 overflow-hidden rounded-lg">
                  <img
                    src={photo.src}
                    alt={photo.alt}
                    width="1600"
                    height="1000"
                    class="absolute inset-0 m-0 h-full w-full object-contain"
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                    draggable="false"
                  />
                </div>
              </div>
            ))}
          </div>
        </div>
        {photos.length > 1 && (
          <>
            <div
              class="from-background pointer-events-none absolute inset-y-0 left-0 z-10 hidden w-1/12 bg-linear-to-r md:block"
              aria-hidden="true"
            />
            <div
              class="from-background pointer-events-none absolute inset-y-0 right-0 z-10 hidden w-1/12 bg-linear-to-l md:block"
              aria-hidden="true"
            />
          </>
        )}
      </div>
      {photos.length > 1 && (
        <div
          class="mt-3 flex items-center justify-center gap-4"
          data-gallery-controls
          data-pagefind-ignore
          hidden
        >
          <button
            type="button"
            class={buttonClass}
            data-gallery-prev
            aria-label={copy.previous}
          >
            <DynamicIcon
              icon="LuChevronLeft"
              className="size-5"
              aria-hidden="true"
            />
          </button>
          <p
            class="text-muted-foreground m-0 min-w-28 text-center text-xs tabular-nums"
            data-gallery-status
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
            {copy.count
              .replace("{current}", "1")
              .replace("{total}", String(photos.length))}
          </p>
          <button
            type="button"
            class={buttonClass}
            data-gallery-next
            aria-label={copy.next}
          >
            <DynamicIcon
              icon="LuChevronRight"
              className="size-5"
              aria-hidden="true"
            />
          </button>
        </div>
      )}
    </gallery-deck>
  )
}

<script>
  import "@/scripts/gallery-deck";
</script>
