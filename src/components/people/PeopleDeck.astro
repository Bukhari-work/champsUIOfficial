---
import PersonCard from "@/components/people/PersonCard.astro";
import { getLangFromUrl } from "@/i18n/utils";
import { peopleCopy } from "./Copy";

import type { CollectionEntry } from "astro:content";
interface Props {
  people: CollectionEntry<"people">[];
}
const { people } = Astro.props;
const copy = peopleCopy[getLangFromUrl(Astro.url)];
---

<people-deck
  class="block"
  data-previous={copy.previous}
  data-next={copy.next}
  data-first={copy.first}
  data-last={copy.last}
  data-slide={copy.slide}
>
  <div class="swiper">
    <div
      class="from-background pointer-events-none absolute inset-y-0 left-0 z-10 hidden w-1/3 bg-linear-to-r md:block"
    >
    </div>
    <div
      class="from-background pointer-events-none absolute inset-y-0 right-0 z-10 hidden w-1/3 bg-linear-to-l md:block"
    >
    </div>
    <div class="peopleDeck-slider mx-auto overflow-hidden rounded-xl p-4">
      <div class="swiper-wrapper">
        {
          people.map((person) => (
            <div class="swiper-slide max-w-sm sm:max-w-xs">
              <PersonCard data={person} />
            </div>
          ))
        }
      </div>

      <!-- Pagination buttons -->
      <div class="flex h-20 items-center">
        <div
          class:list={[
            "person-slider-pagination",
            "flex items-center justify-center text-center",
          ]}
        >
        </div>
        <!-- Navigation buttons -->
        <button
          type="button"
          aria-label={copy.previous}
          class:list={[
            "swiper-button-prev flex",
            "absolute left-1/4 z-10 mx-10 h-11 w-11",
            "bg-primary/10 focus-visible:outline-primary cursor-pointer items-center justify-center rounded-full text-xl select-none hover:bg-black/60 focus-visible:outline-2 focus-visible:outline-offset-2 aria-disabled:cursor-default aria-disabled:opacity-40 dark:hover:bg-white/60",
          ]}
        >
          <span aria-hidden="true">&#10094;</span>
        </button>
        <button
          type="button"
          aria-label={copy.next}
          class:list={[
            "swiper-button-next flex",
            "absolute right-1/4 z-10 mx-10 h-11 w-11",
            "bg-primary/10 focus-visible:outline-primary cursor-pointer items-center justify-center rounded-full text-xl select-none hover:bg-black/60 focus-visible:outline-2 focus-visible:outline-offset-2 aria-disabled:cursor-default aria-disabled:opacity-40 dark:hover:bg-white/60",
          ]}
        >
          <span aria-hidden="true">&#10095;</span>
        </button>
      </div>
    </div>
  </div>
</people-deck>

<script>
  import "./PeopleDeck.client";
</script>
