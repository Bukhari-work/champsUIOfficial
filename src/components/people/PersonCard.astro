---
import { getLocalizedPath, getPageLanguage } from "@/i18n/utils";
import { SETTINGS } from "@/config.ts";
import { cn } from "@/lib/utils.ts";

import Social from "@/components/shared/Social.astro";
import { buttonVariants } from "@/components/ui/button";
import { peopleCopy } from "./Copy";
import Card from "@/components/shared/Card.astro";

import type { CollectionEntry } from "astro:content";

interface Props {
  data: CollectionEntry<"people">;
  size?: "default" | "small";
  imageAspect?: "video" | "portrait" | "landscape" | "square";
  class?: string;
}

const { people_folder } = SETTINGS;
const {
  data,
  size = "default",
  imageAspect = "square",
  class: className,
} = Astro.props;
const { name, responsibility, description, image, social } = data.data;

// Split the data.id (e.g., "en/john-doe") into its parts
const [lang, slug] = data.id.split("/");
const copy = peopleCopy[getPageLanguage(lang)];

// Construct the desired URL: /[lang]/people/[id]
const profileHref = getLocalizedPath(`/about/${people_folder}/${slug}`, lang);
---

<Card
  href={profileHref}
  title={name}
  headingLevel="h2"
  imageMeta={image}
  imageAlt={name}
  {imageAspect}
  {size}
  class={cn("text-left", className)}
>
  <h3 class="mt-1 text-sm font-light">
    {responsibility}
  </h3>

  <div class="mt-2 border-t pt-2">
    <p class="mt-2 mb-4 line-clamp-3">
      {description}
    </p>
  </div>
  {(<Social socialLinks={social} class="relative z-10 w-fit max-w-full" />)}

  <div slot="footer">
    <span
      aria-hidden="true"
      class={buttonVariants({ className: "min-h-11 w-full whitespace-normal" })}
    >
      {copy.viewProfile}
    </span>
  </div>
</Card>
