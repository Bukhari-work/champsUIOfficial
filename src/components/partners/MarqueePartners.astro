---
import { Marquee } from "@/components/ui/marquee/index";

interface Props {
  imagePaths: string[];
  reverse?: boolean;
  /** Scrolling speed in pixels per second. */
  speed?: number;
}

const { imagePaths, reverse = false, speed = 40 } = Astro.props;
// Each card is 136px wide, with an 8px gap. Provide a no-JS fallback.
const duration = (Math.max(imagePaths.length, 1) * 144) / speed;
---

<partner-marquee
  data-speed={speed}
  class="relative flex h-full w-full flex-col items-center justify-center overflow-hidden"
>
  <Marquee
    time={duration}
    direction={reverse ? "right" : "left"}
    variant="solid"
    class="[&:hover_.marquee-content]:paused p-2 px-8 [&_.marquee-content]:gap-2 [&_.marquee-content]:pr-2"
  >
    {
      imagePaths.map((path, index) => (
        <figure class="hover:border-primary relative flex h-full shrink-0 cursor-pointer justify-center rounded-2xl border-2 border-transparent p-4 hover:-translate-y-2 hover:shadow-xl">
          <img
            class="size-25 rounded-lg border-2 object-cover"
            alt={`Partner Image ${index + 1}`}
            src={path}
            width={100}
            height={100}
          />
        </figure>
      ))
    }
  </Marquee>
  <div
    class="from-background pointer-events-none absolute inset-y-0 left-0 w-1/4 bg-linear-to-r"
    aria-hidden="true"
  >
  </div>
  <div
    class="from-background pointer-events-none absolute inset-y-0 right-0 w-1/4 bg-linear-to-l"
    aria-hidden="true"
  >
  </div>
</partner-marquee>

<script>
  import "@/scripts/partner-marquee";
</script>
