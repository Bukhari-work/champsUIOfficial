---
import type { CollectionEntry } from "astro:content";
import type { Language } from "@/i18n/ui";
import { humanize } from "@/lib/utils/textConverter";
import CardNews from "@/components/news/CardNews.astro";
import NewsList from "@/components/news/NewsList.astro";
import DynamicIcon from "@/components/shared/DynamicIcon";

interface Props {
  posts: CollectionEntry<"news">[];
  lang: Language;
}
const { posts, lang } = Astro.props;
const normalize = (value: string) =>
  value.normalize("NFKC").trim().toLocaleLowerCase(lang);
const options = (key: "categories" | "tags") => {
  const values = new Map<string, string>();
  posts.forEach((post) =>
    post.data[key].forEach((value) => {
      if (value.trim()) values.set(normalize(value), humanize(value.trim()));
    }),
  );
  return [...values].sort((a, b) => a[1].localeCompare(b[1], lang));
};
const categories = options("categories");
const tags = options("tags");
const featuredPosts = posts.slice(0, 3);
const featuredIds = featuredPosts.map((post) => post.id);
const copy =
  lang === "id"
    ? {
        search: "Cari berita",
        placeholder: "Cari kata kunci atau topik…",
        category: "Kategori",
        allCategories: "Semua kategori",
        tag: "Tag",
        allTags: "Semua tag",
        clear: "Hapus filter",
        count: "Menampilkan {shown} dari {count} berita",
        emptyTitle: "Belum ada berita yang cocok",
        empty:
          "Coba kata kunci lain atau hapus filter untuk melihat semua berita.",
        sort: "Urutkan",
        newest: "Terbaru",
        oldest: "Terlama",
        more: "Muat lebih banyak",
        results: "Jelajahi berita",
        featured: "Berita pilihan",
        remaining: "Berita lainnya",
      }
    : {
        search: "Search news",
        placeholder: "Search by keyword or topic…",
        category: "Category",
        allCategories: "All categories",
        tag: "Tag",
        allTags: "All tags",
        clear: "Clear filters",
        count: "Showing {shown} of {count} stories",
        emptyTitle: "No stories found",
        empty:
          "Try another keyword or clear the filters to explore all stories.",
        sort: "Sort by",
        newest: "Newest first",
        oldest: "Oldest first",
        more: "Load more stories",
        results: "Explore the news",
        featured: "Featured news",
        remaining: "More news",
      };
const fieldClass =
  "bg-background text-foreground focus-visible:outline-primary min-h-11 w-full min-w-0 rounded-lg border px-3 py-2.5 text-sm focus-visible:outline-2 focus-visible:outline-offset-2";
---

<news-directory
  class="block pb-16 **:[[hidden]]:hidden!"
  data-language={lang}
  data-copy={JSON.stringify(copy)}
>
  <form
    role="search"
    aria-label={copy.search}
    class="mb-8 border-y py-5"
    data-news-controls
    data-pagefind-ignore
    hidden
  >
    <div class="flex flex-col gap-3 lg:flex-row">
      <label class="relative block min-w-0 flex-1">
        <span class="sr-only">{copy.search}</span>
        <span
          class="text-muted-foreground pointer-events-none absolute inset-y-0 left-3 flex items-center"
          ><DynamicIcon
            icon="LuSearch"
            className="size-4"
            aria-hidden="true"
          /></span
        >
        <input
          class={fieldClass + " pl-10"}
          type="search"
          name="q"
          placeholder={copy.placeholder}
          autocomplete="off"
          aria-controls="news-results"
        />
      </label>
      <div class="grid min-w-0 grid-cols-2 gap-3 lg:flex lg:max-w-[65%]">
        <label class="min-w-0 lg:max-w-48">
          <span class="sr-only">{copy.category}</span>
          <select
            class={fieldClass}
            name="category"
            aria-controls="news-results"
          >
            <option value="">{copy.allCategories}</option>
            {
              categories.map(([value, label]) => (
                <option value={value}>{label}</option>
              ))
            }
          </select>
        </label>
        {
          tags.length > 1 && (
            <label class="min-w-0 lg:max-w-40">
              <span class="sr-only">{copy.tag}</span>
              <select
                class={fieldClass}
                name="tag"
                aria-controls="news-results"
              >
                <option value="">{copy.allTags}</option>
                {tags.map(([value, label]) => (
                  <option value={value}>{label}</option>
                ))}
              </select>
            </label>
          )
        }
        <label class="min-w-0 lg:max-w-44">
          <span class="sr-only">{copy.sort}</span>
          <select class={fieldClass} name="sort" aria-controls="news-results">
            <option value="newest">{copy.newest}</option>
            <option value="oldest">{copy.oldest}</option>
          </select>
        </label>
      </div>
    </div>
    <div
      class="text-muted-foreground mt-4 flex min-h-6 flex-wrap items-center justify-between gap-3 text-xs"
    >
      <p data-news-status role="status" aria-live="polite" aria-atomic="true">
      </p>
      <button
        class="text-primary focus-visible:outline-primary cursor-pointer underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 disabled:invisible"
        type="reset">{copy.clear}</button
      >
    </div>
  </form>

  <section
    class="mb-10"
    data-news-featured
    hidden={!featuredPosts.length}
    aria-labelledby="featured-news-title"
  >
    <h2 id="featured-news-title" class="mb-5 text-2xl font-semibold">
      {copy.featured}
    </h2>
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {featuredPosts.map((post, index) => <CardNews data={post} />)}
    </div>
  </section>

  <section id="news-results" aria-label={copy.results}>
    <div
      class="bg-muted/30 rounded-2xl border border-dashed px-6 py-16 text-center"
      data-news-empty
      data-pagefind-ignore
      hidden
    >
      <DynamicIcon
        icon="LuSearchX"
        className="text-muted-foreground mx-auto mb-4 size-8"
        aria-hidden="true"
      />
      <h2 class="text-xl font-semibold">{copy.emptyTitle}</h2>
      <p
        class="text-muted-foreground mx-auto mt-2 max-w-md text-sm leading-relaxed"
      >
        {copy.empty}
      </p>
      <button
        type="button"
        data-news-reset
        class="text-primary focus-visible:outline-primary mt-5 cursor-pointer rounded-lg border px-4 py-2.5 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2"
        >{copy.clear}</button
      >
    </div>
    <div data-news-table hidden={posts.length <= featuredPosts.length}>
      <h2 class="mb-5 text-2xl font-semibold" data-news-list-title>
        {copy.remaining}
      </h2>
      <NewsList {posts} {lang} {featuredIds} />
    </div>
    <div class="mt-10 text-center">
      <button
        type="button"
        data-news-more
        hidden
        class="hover:bg-accent focus-visible:outline-primary cursor-pointer rounded-full border px-6 py-3 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2"
        >{copy.more}</button
      >
    </div>
  </section>
</news-directory>
<script>
  import "@/scripts/news-directory";
</script>
