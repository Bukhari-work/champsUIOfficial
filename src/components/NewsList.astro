---
import { getLocalizedPath } from "@/i18n/utils";
import { humanize, plainify } from "@/lib/utils/textConverter";
import { getCollection, type CollectionEntry } from "astro:content";
import type { Language } from "@/i18n/ui";

interface Props {
  posts: CollectionEntry<"news">[];
  lang: Language;
  featuredIds?: string[];
}
const { posts, lang, featuredIds = [] } = Astro.props;
const authorNames = new Map(
  (await getCollection("people")).map((person) => [
    person.id,
    person.data.name,
  ]),
);
const copy =
  lang === "id"
    ? {
        title: "Berita",
        category: "Kategori",
        date: "Tanggal",
        caption: "Daftar berita",
      }
    : {
        title: "Story",
        category: "Category",
        date: "Published",
        caption: "News articles",
      };
const formatDate = new Intl.DateTimeFormat(lang, {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
---

<div class="bg-background overflow-hidden rounded-xl border">
  <table class="w-full table-fixed border-collapse text-left text-sm">
    <caption class="sr-only">{copy.caption}</caption>
    <thead class="bg-muted/50 text-muted-foreground border-b text-xs">
      <tr>
        <th scope="col" class="px-4 py-3 font-medium sm:px-5">{copy.title}</th>
        <th scope="col" class="hidden w-1/5 px-4 py-3 font-medium md:table-cell"
          >{copy.category}</th
        >
        <th
          scope="col"
          class="w-28 px-3 py-3 text-right font-medium sm:w-36 sm:px-5"
          >{copy.date}</th
        >
      </tr>
    </thead>
    <tbody data-news-rows class="divide-y">
      {
        posts.map((post) => (
          <tr
            data-news-item
            data-promoted={featuredIds.includes(post.id)}
            hidden={featuredIds.includes(post.id)}
            data-date={post.data.date?.getTime() ?? 0}
            data-categories={JSON.stringify(post.data.categories)}
            data-tags={JSON.stringify(post.data.tags)}
            data-search={[
              post.data.title,
              post.data.description,
              post.data.subtitle,
              plainify(post.body ?? ""),
              ...post.data.categories,
              ...post.data.tags,
            ]
              .filter(Boolean)
              .join(" ")}
            class="hover:bg-primary/5 align-top transition-colors motion-reduce:transition-none"
          >
            <td class="px-4 py-4 sm:px-5">
              <a
                class="hover:text-primary focus-visible:outline-primary block rounded-sm leading-relaxed font-medium wrap-break-word underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
                href={getLocalizedPath(
                  "/news/" + post.id.split("/").slice(1).join("/"),
                  lang,
                )}
              >
                {post.data.title}
              </a>
              {post.data.authors.length > 0 && (
                <p class="text-muted-foreground mt-1 text-xs leading-relaxed">
                  {post.data.authors
                    .map((author) => authorNames.get(author.id))
                    .filter(Boolean)
                    .join(", ")}
                </p>
              )}
              <p class="text-primary mt-2 text-xs md:hidden">
                {post.data.categories.map(humanize).join(" · ")}
              </p>
            </td>
            <td class="hidden px-4 py-4 md:table-cell">
              <div class="flex flex-wrap gap-1.5">
                {post.data.categories.map((category) => (
                  <span class="text-primary bg-primary/5 rounded border border-dotted px-2 py-0.5 text-xs">
                    {humanize(category)}
                  </span>
                ))}
              </div>
            </td>
            <td class="text-muted-foreground px-3 py-4 text-right text-xs leading-relaxed sm:px-5">
              {post.data.date && (
                <time datetime={post.data.date.toISOString()}>
                  {formatDate.format(post.data.date)}
                </time>
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
