---
import { cn } from "@/lib/utils";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  class?: string;
  animate?: boolean;
}

const { class: className = "", animate = true, ...rest } = Astro.props as Props;
---

<div
  hidden
  data-slot="dialog-overlay"
  class={cn(
    "bg-black/10 duration-100 supports-backdrop-filter:backdrop-blur-xs fixed inset-0 isolate z-50",
    animate &&
      "data-open:animate-in data-closed:animate-out data-closed:fade-out-0 data-open:fade-in-0",
    className,
  )}
  {...rest}
>
  <slot />
</div>
