---
import type { Headline as Props } from "@/types.ts";
import { cn } from "@/lib/utils.ts";

const {
  title = await Astro.slots.render("title"),
  subtitle = await Astro.slots.render("subtitle"),
  tagline,
  class: className = "max-w-3xl",
  titleClass = "text-3xl md:text-4xl",
  subtitleClass = "text-xl",
} = Astro.props;
---

{
  (title || subtitle || tagline) && (
    <div
      class={cn(
        "prose dark:prose-invert mb-8 text-center md:mx-auto md:mb-12",
        className,
      )}
    >
      {tagline && (
        <p
          class="text-base font-bold tracking-wide uppercase"
          set:html={tagline}
        />
      )}
      {title && (
        <h2
          class={cn(
            "leading-tighter font-heading text-heading text-3xl font-bold tracking-tighter",
            titleClass,
          )}
          set:html={title}
        />
      )}

      {subtitle && <p class={cn("mt-4", subtitleClass)} set:html={subtitle} />}
    </div>
  )
}
