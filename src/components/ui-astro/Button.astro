---
import type { HTMLAttributes } from "astro/types";
import Element from "@/components/ui-astro/Element.astro";
import DynamicIcon from "@/components/shared/DynamicIcon.tsx";
import {
  buttonVariants,
  type ButtonVariantProps,
} from "@/components/ui/button-variants";

import { cn } from "@/lib/utils.ts";

export interface Props
  extends HTMLAttributes<"button">,
    Omit<HTMLAttributes<"a">, "type">,
    HTMLAttributes<"label">,
    ButtonVariantProps {
  text?: string | undefined;
  icon?: string | undefined;
}

const {
  class: className,
  variant = "default",
  size = "default",
  text,
  icon,
  href,
  target = typeof href === "string" && href.startsWith("http")
    ? "_blank"
    : undefined,
  ...rest
} = Astro.props;
---

<Element
  class:list={cn(buttonVariants({ variant, size, className }))}
  as={href ? "a" : rest.for ? "label" : "button"}
  {href}
  {target}
  {...rest}
>
  <Element as="span">
    <Fragment set:html={text} />
  </Element>
  <slot />
  {icon ? <DynamicIcon icon={icon} /> : null}
</Element>
