---
import { Button } from "@/components/ui/button";
import type { Language } from "@/i18n/ui";

export interface Props {
  title: string;
  url: string;
  lang: Language;
}

const { title, url, lang } = Astro.props;
const backend = import.meta.env.CONTACT_FORM_BACKEND === "vercel";
const copy = {
  en: {
    name: "Full name",
    email: "Email address",
    message: "Message",
    submit: "Send message",
    submitting: "Sending…",
    success: "Thanks — your message was sent.",
    received: "Thanks — your message has been received.",
    rateLimited:
      "Too many messages have been submitted. Please try again later or email CHAMPS UI.",
    error:
      "The form could not send your message. You can send it by email instead.",
    emailFallback: "Email CHAMPS UI",
    errorConfig: "The form is unavailable right now. Please email CHAMPS UI.",
  },
  id: {
    name: "Nama lengkap",
    email: "Alamat email",
    message: "Pesan",
    submit: "Kirim pesan",
    submitting: "Mengirim…",
    success: "Terima kasih — pesan Anda telah terkirim.",
    received: "Terima kasih — pesan Anda telah diterima.",
    rateLimited:
      "Terlalu banyak pesan yang dikirim. Silakan coba lagi nanti atau email CHAMPS UI.",
    error:
      "Pesan belum dapat dikirim lewat formulir. Anda dapat mengirimnya lewat email.",
    emailFallback: "Email CHAMPS UI",
    errorConfig: "Formulir sedang tidak tersedia. Silakan email CHAMPS UI.",
  },
}[lang];
---

<section class="bg-background min-w-0 rounded-2xl border p-5 sm:p-7 lg:p-8">
  <h2 class="font-libron mb-6 text-2xl sm:text-3xl">{title}</h2>
  <form
    id="contactForm"
    class="scroll-mt-32 space-y-5"
    method="POST"
    action={backend ? "/api/contact" : url}
    data-contact-url={backend ? "/api/contact" : url}
    data-contact-backend={backend ? "vercel" : "legacy"}
    data-contact-success={backend ? copy.received : copy.success}
    data-contact-rate-limit={copy.rateLimited}
    data-contact-error={copy.error}
    data-contact-config-error={copy.errorConfig}
    data-contact-fallback-label={copy.emailFallback}
    data-submit-label={copy.submit}
    data-submitting-label={copy.submitting}
  >
    <input type="hidden" name="language" value={lang} />
    <div>
      <label for="name" class="mb-2 block text-sm font-medium">
        {copy.name}
        <span class="text-destructive" aria-hidden="true">*</span>
      </label>
      <input
        id="name"
        name="name"
        class="border-input bg-background focus-visible:outline-primary placeholder:text-muted-foreground w-full rounded-lg border px-3.5 py-2.5 text-sm shadow-sm transition outline-none focus-visible:outline-2 focus-visible:outline-offset-2"
        placeholder="Budi Susanti"
        type="text"
        autocomplete="name"
        maxlength="120"
        required
      />
    </div>

    <div class="hidden" aria-hidden="true">
      <label for="website" class="form-label">Website</label>
      <input
        id="website"
        name="website"
        class="form-input w-full"
        placeholder="champs-ui.org"
        type="text"
        autocomplete="off"
        tabindex="-1"
      />
    </div>

    <div>
      <label for="email" class="mb-2 block text-sm font-medium">
        {copy.email}
        <span class="text-destructive" aria-hidden="true">*</span>
      </label>
      <input
        id="email"
        name="email"
        class="border-input bg-background focus-visible:outline-primary placeholder:text-muted-foreground w-full rounded-lg border px-3.5 py-2.5 text-sm shadow-sm transition outline-none focus-visible:outline-2 focus-visible:outline-offset-2"
        placeholder="budi.susanti@email.com"
        type="email"
        autocomplete="email"
        maxlength="254"
        required
      />
    </div>

    <div>
      <label for="message" class="mb-2 block text-sm font-medium">
        {copy.message}
        <span class="text-destructive" aria-hidden="true">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        class="border-input bg-background focus-visible:outline-primary placeholder:text-muted-foreground w-full resize-y rounded-lg border px-3.5 py-2.5 text-sm shadow-sm transition outline-none focus-visible:outline-2 focus-visible:outline-offset-2"
        placeholder="Message goes here..."
        rows="5"
        maxlength="10000"
        required>{""}</textarea
      >
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <Button id="submitBtn" type="submit">{copy.submit}</Button>
    </div>
    <div class="space-y-2" data-contact-feedback hidden>
      <p
        class="text-sm leading-relaxed"
        role="status"
        aria-live="polite"
        data-contact-status
      >
      </p>
      <a
        class="text-primary focus-visible:outline-primary inline-flex min-h-11 items-center rounded underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2"
        data-contact-fallback
        hidden></a>
    </div>
  </form>
</section>

<script>
  function initializeContactForm() {
    const form = document.getElementById(
      "contactForm",
    ) as HTMLFormElement | null;
    const submitBtn = document.getElementById(
      "submitBtn",
    ) as HTMLButtonElement | null;

    if (form && submitBtn && !form.dataset.initialized) {
      form.dataset.initialized = "true";
      let pendingSubmission: { signature: string; id: string } | undefined;
      const recaptchaSiteKey = "6LckcswrAAAAAD9Y9Erk6tzAOWtdZXGiUKpNc_dh";
      const feedback = form.querySelector<HTMLElement>(
        "[data-contact-feedback]",
      )!;
      const status = form.querySelector<HTMLElement>("[data-contact-status]")!;
      const fallback = form.querySelector<HTMLAnchorElement>(
        "[data-contact-fallback]",
      )!;
      let recaptchaPromise: Promise<any> | undefined;

      const loadRecaptcha = () => {
        const existing = (window as any).grecaptcha;
        if (existing?.ready) return Promise.resolve(existing);
        if (!recaptchaPromise) {
          recaptchaPromise = new Promise((resolve, reject) => {
            const script = document.createElement("script");
            script.src = `https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`;
            script.async = true;
            script.onload = () => {
              const recaptcha = (window as any).grecaptcha;
              recaptcha?.ready
                ? resolve(recaptcha)
                : reject(new Error("reCAPTCHA did not initialize."));
            };
            script.onerror = () =>
              reject(new Error("reCAPTCHA could not be loaded."));
            document.head.appendChild(script);
          });
        }
        return recaptchaPromise;
      };

      const showFeedback = (message: string, emailHref?: string) => {
        status.textContent = message;
        feedback.hidden = false;
        fallback.hidden = !emailHref;
        if (emailHref) {
          fallback.href = emailHref;
          fallback.textContent =
            form.dataset.contactFallbackLabel ?? "Email CHAMPS UI";
        }
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (submitBtn.disabled) return;
        if (!form.reportValidity()) return;
        if (
          (form.elements.namedItem("website") as HTMLInputElement).value.trim()
        )
          return;

        const url = form.dataset.contactUrl;
        const data = new FormData(form);
        const name = String(data.get("name") ?? "").trim();
        const email = String(data.get("email") ?? "").trim();
        const message = String(data.get("message") ?? "").trim();
        const backend = form.dataset.contactBackend === "vercel";
        const mailto = new URL("mailto:champs@ui.ac.id");
        mailto.searchParams.set("subject", `Website contact from ${name}`);
        mailto.searchParams.set(
          "body",
          `Name: ${name}\nEmail: ${email}\n\n${message}`,
        );

        if (!url) {
          showFeedback(
            form.dataset.contactConfigError ?? form.dataset.contactError ?? "",
            mailto.href,
          );
          return;
        }

        submitBtn.disabled = true;
        const fields = form.querySelectorAll<
          HTMLInputElement | HTMLTextAreaElement
        >("input:not([type=hidden]), textarea");
        fields.forEach((field) => {
          field.readOnly = true;
        });
        submitBtn.textContent = form.dataset.submittingLabel ?? "Sending…";
        showFeedback(submitBtn.textContent);

        try {
          if (backend) {
            const signature = JSON.stringify([name, email, message]);
            if (pendingSubmission?.signature !== signature) {
              pendingSubmission = { signature, id: crypto.randomUUID() };
            }
            data.set("submission_id", pendingSubmission.id);
          } else {
            const recaptcha = await loadRecaptcha();
            const token = await new Promise<string>((resolve, reject) => {
              recaptcha.ready(() => {
                recaptcha
                  .execute(recaptchaSiteKey, { action: "submit" })
                  .then(resolve, reject);
              });
            });
            data.append("recaptchaToken", token);
          }

          const response = await fetch(url, {
            method: "POST",
            body: data,
            headers: { Accept: "application/json" },
            signal: AbortSignal.timeout(30000),
          });
          if (response.status === 429) {
            showFeedback(
              form.dataset.contactRateLimit ?? form.dataset.contactError ?? "",
              mailto.href,
            );
            return;
          }
          if (response.status === 409) pendingSubmission = undefined;
          if (!response.ok)
            throw new Error(`Request failed (${response.status}).`);
          const result = await response.json();
          if (result.status !== "success")
            throw new Error(result.message || "Message delivery failed.");

          form.reset();
          pendingSubmission = undefined;
          showFeedback(form.dataset.contactSuccess ?? "Message sent.");
        } catch (error) {
          console.error("Contact form submission failed:", error);
          showFeedback(
            form.dataset.contactError ?? "Message could not be sent.",
            mailto.href,
          );
        } finally {
          fields.forEach((field) => {
            field.readOnly = false;
          });
          submitBtn.disabled = false;
          submitBtn.textContent = form.dataset.submitLabel ?? "Send message";
        }
      });
    }
  }
  initializeContactForm();
  document.addEventListener("astro:page-load", initializeContactForm);
</script>
