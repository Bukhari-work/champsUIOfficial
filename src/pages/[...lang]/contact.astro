---
import Base from "@/layouts/Base.astro";
import DynamicIcon from "@/components/shared/DynamicIcon.tsx";
import ContactForm from "@/components/contact/ContactForm.astro";

import { SETTINGS } from "@/config.ts";
import {
  getLangFromUrl,
  useTranslations,
  getLocaleStaticPaths,
} from "@/i18n/utils";
import type { BaseLayoutProps } from "@/types.ts";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const content: BaseLayoutProps["content"] = {
  title: t("contact.seo.title"),
  description: t("contact.seo.description"),
  // canonical: "https://www.champs-ui.org/contact" // Optional: uncomment if needed
};

const contactDetails = {
  title: t("contact.details.title"), // "Email and Website"
  items: [
    {
      icon: "LuMail",
      text: "champs@ui.ac.id",
      href: "mailto:champs@ui.ac.id",
    },
    {
      icon: "LuMail",
      text: "champsui09@gmail.com",
      href: "mailto:champsui09@gmail.com",
    },
    {
      icon: "LuGlobe",
      text: "www.champs-ui.org",
      href: "/", // Assumes root link
    },
  ],
};

const socials = {
  title: t("contact.socials.title"), // "Social Media"
  items: [
    {
      icon: "FaWhatsapp",
      text: "+62 813 2409 6624",
      href: "https://wa.me/+6281324096624",
    },
    {
      icon: "LuFacebook",
      text: "Champs FKM UI",
      href: "https://www.facebook.com/champs.fkmui",
    },
    {
      icon: "LuLinkedin",
      text: "Champs FKM UI",
      href: "https://www.linkedin.com/company/champsui",
    },
    {
      icon: "LuInstagram",
      text: "@champs_UI",
      href: "https://www.instagram.com/champs_ui",
    },
    {
      icon: "LuYoutube",
      text: t("contact.socials.youtube"), // "Pusat Kajian AKK FKM UI"
      href: "https://youtube.com/@champsfphui?si=uADFIoR8DUT7m-RV",
    },
  ],
};

const address = {
  title: t("contact.address.title"), // "Address"
  line1: t("contact.address.line1"), // "Room 312, Building G, 3rd Floor of"
  location: t("contact.address.location"), // "Faculty of Public Health Universitas Indonesia"
  locationHref:
    "https://maps.google.com/?q=Faculty+of+Public+Health+Universitas+Indonesia",
  line2: t("contact.address.line2"), // "Depok, West Java Indonesia"
  gmapEmbedSrc:
    "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3965.241610479638!2d106.8327170153434!3d-6.362768564036663!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69ec18a7c646b7%3A0x219d443918032748!2sFakultas%20Kesehatan%20Masyarakat%20Universitas%20Indonesia!5e0!3m2!1sen!2sid!4v1678888888888!5m2!1sen!2sid", // Your embed link
};
---

<Base {content}>
  <main class="mx-auto max-w-7xl px-5 pb-20 sm:px-8">
    <header class="mx-auto mt-8 max-w-7xl sm:mt-12">
      <div class="ml-auto max-w-4xl text-right">
        <p
          class="text-primary mb-5 flex items-center justify-end gap-3 font-mono text-xs tracking-widest uppercase"
        >
          {t("contact.pageHeader")}
          <span class="bg-primary h-px w-10" aria-hidden="true"></span>
        </p>
        <h1 class="font-libron text-4xl leading-tight text-balance sm:text-6xl">
          {t("contact.intro.title")}
        </h1>
        <p
          class="text-muted-foreground mt-5 ml-auto max-w-2xl text-base leading-relaxed sm:text-lg"
        >
          {t("contact.intro.paragraph")}
        </p>
      </div>
    </header>

    <div class="mt-6 grid items-start gap-5 lg:mt-8 lg:grid-cols-12 lg:gap-6">
      <div class="min-w-0 lg:col-span-7">
        <ContactForm
          title={t("contact.form.title")}
          url={SETTINGS.contact_form_url}
          {lang}
        />
      </div>

      <aside class="min-w-0 space-y-5 lg:col-span-5">
        <section class="bg-background rounded-2xl border p-5 sm:p-6">
          <h2 class="font-libron mb-4 text-xl">{contactDetails.title}</h2>
          <ul class="space-y-2">
            {
              contactDetails.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="hover:bg-primary/5 focus-visible:outline-primary flex min-h-12 min-w-0 items-center gap-3 rounded-xl px-2 py-2 text-sm focus-visible:outline-2 focus-visible:outline-offset-2"
                    target={item.href.startsWith("http") ? "_blank" : "_self"}
                    rel="noopener noreferrer"
                  >
                    <span class="bg-primary-soft text-primary flex size-9 shrink-0 items-center justify-center rounded-lg">
                      <DynamicIcon icon={item.icon} className="size-4" />
                    </span>
                    <span class="min-w-0 wrap-anywhere">{item.text}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="bg-background rounded-2xl border p-5 sm:p-6">
          <h2 class="font-libron mb-4 text-xl">{socials.title}</h2>
          <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
            {
              socials.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="hover:bg-primary/5 focus-visible:outline-primary flex min-h-12 min-w-0 items-center gap-3 rounded-xl px-2 py-2 text-sm focus-visible:outline-2 focus-visible:outline-offset-2"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="bg-primary-soft text-primary flex size-9 shrink-0 items-center justify-center rounded-lg">
                      <DynamicIcon icon={item.icon} className="size-4" />
                    </span>
                    <span class="min-w-0 wrap-anywhere">{item.text}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="bg-background overflow-hidden rounded-2xl border">
          <div class="p-5 sm:p-6">
            <h2 class="font-libron mb-3 text-xl">{address.title}</h2>
            <p class="text-muted-foreground text-sm leading-relaxed">
              {address.line1}<br />
              <a
                href={address.locationHref}
                class="text-foreground decoration-primary/30 hover:decoration-primary underline underline-offset-4"
                target="_blank"
                rel="noopener noreferrer"
              >
                {address.location}
              </a><br />
              {address.line2}
            </p>
          </div>
          <iframe
            title={address.title}
            src={address.gmapEmbedSrc}
            allowfullscreen=""
            class="aspect-video w-full border-t"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          >
          </iframe>
        </section>
      </aside>
    </div>
  </main>
</Base>
