---
import {
  getLocaleStaticPaths,
  getLocalizedPath,
  getPageLanguage,
  useTranslations,
} from "@/i18n/utils";

import Base from "@/layouts/Base.astro";
import { getProgrammeCategories } from "@/data/programmes";
import { getWhatWeDoActivities } from "@/lib/contentCatalog";
import { contentCopy } from "@/i18n/content";
import { SITE } from "@/config";
import PageHero from "@/components/directories/PageHero.astro";
import KeepExploring from "@/components/directories/KeepExploring.astro";
import { whatWeDoCopy } from "@/i18n/what-we-do";
import ExpertiseTabs from "@/components/directories/what-we-do/ExpertiseTabs.astro";

export async function getStaticPaths() {
  return getLocaleStaticPaths();
}

const lang = getPageLanguage(Astro.params.lang);

const t = useTranslations(lang);
const copy = whatWeDoCopy[lang];
const navigationCopy = contentCopy[lang];

const content = {
  title: t("nav.whatWeDo"),
  meta_title: t("whatWeDo.meta.title"),
  description: t("whatWeDo.meta.description"),
  canonical: new URL(getLocalizedPath("/what-we-do", lang), SITE.base_href),
};

const categories = getProgrammeCategories(lang);
const items = await getWhatWeDoActivities(lang);
const workshop = categories.find((category) => category.id === "capacity")!;
---

<Base {content}>
  <div class="mx-auto max-w-400 px-5 pt-10 pb-16 sm:px-8" data-what-we-do>
    <PageHero
      eyebrow={t("nav.whatWeDo")}
      title={copy.pageTitle}
      description={copy.pageIntro}
      image={{ src: workshop.image, alt: copy.heroImageAlt }}
      textLink={{
        href: `${getLocalizedPath("/contact", lang)}#contactForm`,
        label: copy.discussCollaboration,
      }}
    />
    <ExpertiseTabs {categories} {items} {lang} />
    <KeepExploring
      headingId="expertise-next-links-title"
      title={navigationCopy.keepExploring}
      links={[
        {
          href: getLocalizedPath("/events", lang),
          label: navigationCopy.exploreEvents,
          description: navigationCopy.eventsLinkIntro,
        },
        {
          href: getLocalizedPath("/what-we-do/archive", lang),
          label: navigationCopy.archiveName,
          description: navigationCopy.archiveLinkIntro,
        },
      ]}
      data-expertise-next-links
    />
  </div>
</Base>
