---
import {
  getLocaleStaticPaths,
  getPageLanguage,
  useTranslations,
} from "@/i18n/utils";

import { getSinglePage } from "@/lib/contentParser.ts";
import type { CollectionEntry } from "astro:content";

import SidebarLayout from "@/layouts/SidebarLayout.astro";
import CardAuthor from "@/components/people/CardAuthor.astro";
import { getSidebar } from "@/navigation";

export async function getStaticPaths() {
  return getLocaleStaticPaths();
}

const lang = getPageLanguage(Astro.params.lang);

const t = useTranslations(lang);
const PEOPLE_FOLDER = "people";

// --- Page & Sidebar Metadata ---

const sideBar = getSidebar(lang, "about");

// --- Fetch and Filter People Data ---
// Fetch all non-draft people (from ALL languages)
const allPeople: CollectionEntry<"people">[] =
  await getSinglePage(PEOPLE_FOLDER);

// Filter the results by the current language
const people: CollectionEntry<"people">[] = allPeople.filter((person) =>
  person.id.startsWith(`${lang}/`),
);

const experts = people.filter(
  (person) => person.data.responsibility === "Senior Expert",
);
const researcher = people.filter(
  (person) => person.data.responsibility === "Senior Researcher",
);

const sortPeopleByIndex = (peopleArray: CollectionEntry<"people">[]) => {
  return peopleArray.sort((a, b) => {
    // People with an undefined index are pushed to the end.
    const aIndex = a.data.index ?? Infinity;
    const bIndex = b.data.index ?? Infinity;
    return aIndex - bIndex;
  });
};

// --- Sort People Data ---
const sortedExperts = sortPeopleByIndex(experts);
const sortedResearchers = sortPeopleByIndex(researcher);

const content = { title: t("sidebar.about.item.experts") };
---

<SidebarLayout {content} {sideBar} variant="wide">
  <h1
    class="text-primary mt-8 mb-2 w-fit scroll-mt-24 text-3xl font-semibold sm:text-4xl lg:text-6xl"
  >
    {t("about.experts.title")}
  </h1>
  <div class="w-full">
    <div>
      <h2 class="text-3xl">{t("about.experts.seniorExperts")}</h2>
      <div
        class="not-prose grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3"
      >
        {sortedExperts.map((person) => <CardAuthor data={person} />)}
      </div>
      <h2 class="text-3xl">{t("about.experts.seniorResearchers")}</h2>
      <div
        class="not-prose grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3"
      >
        {sortedResearchers.map((person) => <CardAuthor data={person} />)}
      </div>
    </div>
  </div>
</SidebarLayout>
