---
import Base from "@/layouts/Base.astro";
import { i18n } from "@/config";
import type { Language } from "@/i18n/ui.ts";
import { getLocalizedPath, getPageLanguage } from "@/i18n/utils";

import { getSinglePage } from "@/lib/contentParser.ts";

import { Image } from "astro:assets";
import { render } from "astro:content";
import Social from "@/components/shared/Social.astro";
import ProfileBiography from "@/components/people/ProfileBiography.astro";
import { peopleCopy } from "@/components/people/Copy";

// --- Static Paths Function (from [single].astro) ---
export async function getStaticPaths() {
  const PEOPLE_FOLDER = "people";
  const people = await getSinglePage(PEOPLE_FOLDER);

  // Create a path for each post, using the lang and slug from its own ID
  const paths = people
    .map((person) => {
      const idParts = person.id.split("/"); // e.g., ['en', 'post-slug']

      // Basic validation
      if (idParts.length < 2) {
        console.warn(
          `[getStaticPaths] Skipping post with invalid ID: ${person.id}`,
        );
        return null;
      }

      const lang = idParts[0] as Language;
      const slug = idParts[1];

      // Validate that the lang from the post ID is a valid locale
      if (!i18n.locales.includes(lang)) {
        console.warn(
          `[getStaticPaths] Skipping post with unknown lang '${lang}' in ID: ${person.id}`,
        );
        return null;
      }

      return {
        params: {
          lang: lang === i18n.defaultLocale ? undefined : lang,
          single: slug,
        },
        props: { person },
      };
    })
    .filter((path) => path !== null); // Filter out any nulls from skipped posts

  return paths;
}

const { person } = Astro.props;

const lang = getPageLanguage(Astro.params.lang);
const {
  name,
  responsibility,
  role,
  description,
  expertise = [],
  image,
  social,
} = person.data;
const { Content } = await render(person);

const uniqueId = person.id.replace(/[^a-zA-Z0-9]/g, ""); // Sanitize ID
const hasBiography = Boolean(person.body?.trim());
const copy = peopleCopy[lang];
const aboutHref = getLocalizedPath("/about", lang);
const peopleHref = getLocalizedPath("/about/people", lang);
const content = { title: name, description };
---

<Base content={content} makara>
  <main class="mx-auto max-w-7xl px-5 pt-8 pb-16 sm:px-8 lg:pt-12">
    <nav
      aria-label={copy.about}
      class="text-primary mb-5 flex min-h-11 flex-wrap items-center gap-x-3 font-mono text-xs uppercase"
    >
      <a
        href={aboutHref}
        class="focus-visible:outline-primary inline-flex min-h-11 items-center rounded underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        {copy.about}
      </a>
      <span class="text-muted-foreground" aria-hidden="true">/</span>
      <a
        href={peopleHref}
        class="focus-visible:outline-primary inline-flex min-h-11 items-center rounded underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        {copy.backToPeople}
      </a>
    </nav>

    <div
      class="bg-background grid overflow-hidden rounded-2xl border shadow-sm lg:grid-cols-[minmax(0,1.1fr)_minmax(19rem,0.9fr)]"
    >
      <header
        class="bg-primary/5 flex min-w-0 flex-col justify-center p-6 sm:p-9 lg:p-12"
      >
        <p class="text-muted-foreground mb-3 text-sm sm:text-base">
          <span class="text-primary font-libron text-xs tracking-widest uppercase">
            {role}
          </span>
          {
            responsibility && (
              <>
                <span class="mx-2 text-primary/60" aria-hidden="true">·</span>
                <span class="font-libron" transition:name={`person-role-${person.id}`}>
                  {responsibility}
                </span>
              </>
            )
          }
        </p>
        <h1
          class="font-libron max-w-3xl text-2xl leading-tight text-balance wrap-anywhere sm:text-3xl lg:text-4xl"
        >
          <span transition:name={`person-name-${person.id}`}>{name}</span>
        </h1>
        {
          social?.length > 0 && (
            <div class="border-primary/20 mt-6 border-t pt-4">
              <Social socialLinks={social} class="flex-wrap" />
            </div>
          )
        }
      </header>

      <div class="min-w-0">
        {
          image ? (
            <figure class="bg-muted/20 h-full min-h-64 overflow-hidden lg:min-h-96">
              <Image
                class="h-full min-h-64 w-full object-cover lg:min-h-96"
                src={image.src}
                alt={name}
                width={720}
                height={576}
                format="webp"
                transition:name={`person-image-${person.id}`}
              />
            </figure>
          ) : (
            <div class="bg-primary/10 text-primary flex h-full min-h-64 items-center justify-center text-6xl font-semibold lg:min-h-96">
              {name
                .split(/\s+/)
                .slice(0, 2)
                .map((part) => part[0])
                .join("")}
            </div>
          )
        }
      </div>
    </div>

    <div
      class:list={[
        "mt-8 grid items-start gap-6 sm:mt-10",
        expertise.length > 0 &&
          "lg:grid-cols-[minmax(0,1.6fr)_minmax(16rem,0.7fr)]",
      ]}
    >
      <section
        class="bg-background min-w-0 rounded-2xl border p-6 sm:p-8 lg:p-10"
      >
        <h2 class="font-libron mb-5 text-2xl sm:text-3xl">{copy.biography}</h2>
        {
          hasBiography ? (
            <ProfileBiography id={`biography-${uniqueId}`} {lang}>
              <Content />
            </ProfileBiography>
          ) : description ? (
            <p class="text-muted-foreground max-w-prose text-base leading-relaxed sm:text-lg">
              {description}
            </p>
          ) : (
            <p class="text-muted-foreground max-w-prose text-base leading-relaxed">
              {copy.profileDetailsUnavailable}
            </p>
          )
        }
      </section>

      {
        expertise.length > 0 && (
          <aside class="bg-background min-w-0 rounded-2xl border p-6 sm:p-8">
            <h2 class="text-muted-foreground mb-4 font-mono text-xs tracking-widest uppercase">
              {copy.expertise}
            </h2>
            <ul class="flex flex-wrap gap-2">
              {expertise.map((item) => (
                <li class="bg-primary/5 rounded-full border px-3 py-1.5 text-sm">
                  {item}
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </main>
</Base>
