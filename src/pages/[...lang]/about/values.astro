---
import {
  getLocaleStaticPaths,
  getPageLanguage,
  useTranslations,
} from "@/i18n/utils";

import SidebarLayout from "@/layouts/SidebarLayout.astro";
import { getSidebar } from "@/navigation.ts";

export async function getStaticPaths() {
  return getLocaleStaticPaths();
}

const lang = getPageLanguage(Astro.params.lang);

const t = useTranslations(lang);

const sideBar = getSidebar(lang, "about");

// Prop for the layout (title for the browser tab, SEO, etc.)
const content = { title: t("sidebar.about.item.values") };
---

<SidebarLayout {content} {sideBar}>
  <h1
    class="font-lexend text-primary mt-8 mb-2 w-fit scroll-mt-24 text-6xl font-semibold"
  >
    {t("about.values.title")}
  </h1>
  <p>{t("about.values.intro")}</p>

  <div>
    <h2>{t("about.values.objectivity.title")}</h2>
    <p set:html={t("about.values.objectivity.desc")} />
  </div>
  <div>
    <h2>{t("about.values.togetherness.title")}</h2>
    <p set:html={t("about.values.togetherness.desc")} />
  </div>
  <div>
    <h2>{t("about.values.empowerment.title")}</h2>
    <p set:html={t("about.values.empowerment.desc")} />
  </div>
  <div>
    <h2>{t("about.values.quality.title")}</h2>
    <p set:html={t("about.values.quality.desc")} />
  </div>
  <div>
    <h2>{t("about.values.sincerity.title")}</h2>
    <p set:html={t("about.values.sincerity.desc")} />
  </div>

  <hr class="bg-primary/10! my-8 h-px! w-full border-0! border-t" />
  <p class="text-center">
    {t("about.contactText")}
    <a href="mailto:champs@ui.ac.id">champs@ui.ac.id</a>.
  </p>
</SidebarLayout>
