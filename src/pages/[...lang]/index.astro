---
import {
  getLocaleStaticPaths,
  getPageLanguage,
  useTranslations,
} from "@/i18n/utils";

import Base from "@/layouts/Base.astro";
import Hero from "@/components/home/sections/Hero.astro";
import ApproachBand from "@/components/home/sections/ApproachBand.astro";
import Expertise from "@/components/home/sections/Expertise.astro";
import YearReview from "@/components/home/sections/YearReview.astro";
import Purpose from "@/components/home/sections/Purpose.astro";
import PhotoDivider from "@/components/home/sections/PhotoDivider.astro";
import Work from "@/components/home/sections/Work.astro";
import Collaboration from "@/components/home/sections/Collaboration.astro";
import AnnouncementBanner from "@/components/announcements/AnnouncementBanner.astro";
import { homeAnnouncement } from "@/data/announcements";
import { getImage } from "astro:assets";
import { heroPhoto } from "@/assets/home";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}
const lang = getPageLanguage(Astro.params.lang);
const t = useTranslations(lang);
const socialImage = await getImage({
  src: heroPhoto,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpeg",
  quality: 80,
});
const content = {
  title: t("nav.home"),
  description: t("site.description"),
  image: socialImage.src,
  imageAlt: t("home.hero.photoAlt"),
  canonical: Astro.url.href,
};
---

<Base {content} makara={true} mainClass="mx-0 mt-0 border-x-0 md:mx-0 lg:mx-0">
  <div data-homepage>
    <Hero {lang} />
    <ApproachBand {lang} />
    <Expertise {lang} />
    <YearReview {lang} />
    <Purpose {lang} />
    <PhotoDivider {lang} />
    <Work {lang} />
    <Collaboration {lang} />
    <AnnouncementBanner {lang} campaign={homeAnnouncement} />
  </div>
</Base>
