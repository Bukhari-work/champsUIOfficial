---
import {
  getLocaleStaticPaths,
  getPageLanguage,
  useTranslations,
  getLocalizedPath,
} from "@/i18n/utils";

import Base from "@/layouts/Base.astro";
import Hero from "@/components/home/sections/Hero.astro";
import ApproachBand from "@/components/home/sections/ApproachBand.astro";
import Expertise from "@/components/home/sections/Expertise.astro";
import YearReview from "@/components/home/sections/YearReview.astro";
import Purpose from "@/components/home/sections/Purpose.astro";
import PhotoDivider from "@/components/home/sections/PhotoDivider.astro";
import News from "@/components/home/sections/News.astro";
import Collaboration from "@/components/home/sections/Collaboration.astro";
import InvitationModal from "@/components/shared/InvitationModal.astro";
import { getImage } from "astro:assets";
import { heroPhoto } from "@/assets/home";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}
const lang = getPageLanguage(Astro.params.lang);
const t = useTranslations(lang);
const socialImage = await getImage({
  src: heroPhoto,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpeg",
  quality: 80,
});
const content = {
  title: t("nav.home"),
  description: t("site.description"),
  image: socialImage.src,
  imageAlt: t("home.hero.photoAlt"),
  canonical: Astro.url.href,
};
---

<Base {content} makara={true} mainClass="mx-0 mt-0 border-x-0 md:mx-0 lg:mx-0">
  <div data-homepage>
    <Hero {lang} />
    <ApproachBand {lang} />
    <Expertise {lang} />
    <YearReview {lang} />
    <Purpose {lang} />
    <PhotoDivider {lang} />
    <News {lang} />
    <Collaboration {lang} />
    <InvitationModal storageKey={`tna-invitation-${lang}`}>
      <h2 id="invitation-title" class="text-2xl font-semibold">
        {t("tna.modal.title")}
      </h2>
      <p class="text-muted-foreground mt-4">{t("tna.modal.description")}</p>
      <a
        href={getLocalizedPath("/projects/tna-champs-ui", lang)}
        class="bg-primary text-primary-foreground mt-6 inline-flex rounded-xl px-6 py-3 font-medium hover:opacity-90"
      >
        {t("tna.modal.cta")}</a
      >
    </InvitationModal>
  </div>
</Base>
