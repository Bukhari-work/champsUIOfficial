# Keep legacy until Neon is connected, the SQL migration is applied, and Resend
# is verified. Switching to vercel requires a rebuild/redeployment of the pages.
CONTACT_FORM_BACKEND=legacy

# Private server credentials. Neon can add DATABASE_URL through its integration.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
RESEND_API_KEY=re_replace_with_your_api_key
CONTACT_EMAIL_FROM="CHAMPS UI Website <website@champs.bukhari.day>"
CONTACT_EMAIL_TO=champs@ui.ac.id

# Generate once: openssl rand -hex 32
CONTACT_RATE_LIMIT_SECRET=replace_with_output_of_openssl_rand_hex_32
